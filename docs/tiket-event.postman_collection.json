    {
      "name": "4. Midtrans (simulasi webhook)",
      "item": [
        {
          "name": "Notifikasi signature palsu (harus 403)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/midtrans/notification",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "midtrans",
                "notification"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transaction_status\": \"settlement\",\n  \"status_code\": \"200\",\n  \"order_id\": \"{{order_code}}\",\n  \"gross_amount\": \"{{gross_amount}}\",\n  \"signature_key\": \"palsu\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Notifikasi settlement",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/midtrans/notification",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "midtrans",
                "notification"
              ]
            },
            "description": "Meniru notifikasi Midtrans untuk order terakhir. Isi variabel server_key terlebih dahulu.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transaction_status\": \"settlement\",\n  \"status_code\": \"200\",\n  \"order_id\": \"{{order_code}}\",\n  \"gross_amount\": \"{{gross_amount}}\",\n  \"payment_type\": \"bank_transfer\",\n  \"transaction_id\": \"simulasi-postman\",\n  \"fraud_status\": \"accept\",\n  \"signature_key\": \"{{signature_key}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// signature_key = sha512(order_id + status_code + gross_amount + server_key)",
                  "const sig = CryptoJS.SHA512(",
                  "  pm.variables.get('order_code') + '200' +",
                  "  pm.variables.get('gross_amount') + pm.variables.get('server_key')",
                  ").toString();",
                  "pm.collectionVariables.set('signature_key', sig);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
